  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev --turbo",
    "dev:full": "docker-compose up -d && next dev --turbo",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f redis",
    "redis:cli": "docker exec -it crm-redis redis-cli",
    "lint": "eslint .",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "production:check": "tsx scripts/production-preflight.ts",
    "production:verify-db": "tsx scripts/production-db-verify.ts",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:restore:test": "tsx scripts/db-restore-test.ts",
    "worker": "tsx scripts/start-worker.ts",
    "worker:dev": "tsx watch scripts/start-worker.ts",
    "db:types": "npx supabase gen types typescript --project-id YOUR_PROJECT_ID > lib/types/database.types.ts",
    "db:types:local": "npx supabase gen types typescript --local > lib/types/database.types.ts",
    "typecheck": "tsc --noEmit"
  },
